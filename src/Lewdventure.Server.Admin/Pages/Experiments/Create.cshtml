@page
@model Server.Admin.Pages.Experiments.CreateModel
@{
    ViewData["Title"] = "Новый эксперимент";
}
<h1>Новый эксперимент · @Model.CurrentEnvironment</h1>
<partial name="_Messages" model="Model" />
<p class="muted">Эксперимент создаётся черновиком. Проценты считаются от игроков, подходящих под фильтр группы; суммарно по любой стране группы всех идущих экспериментов не могут занять больше 100%. Остальные игроки получают мастер. Контрольная группа — группа со снапшотом мастера.</p>
<form method="post" class="card form">
    <div class="row">
        <label>Id <input asp-for="ExperimentId" placeholder="balance-2026-10" pattern="[a-z0-9_\-]{1,40}" required></label>
        <label>Название <input asp-for="Name" required></label>
    </div>
    <label>Описание <textarea asp-for="Description" rows="2"></textarea></label>
    <table class="table groups">
        <thead>
        <tr><th>Id группы</th><th>Название</th><th>Снапшот</th><th>%</th><th>Только новые</th><th>Страны</th><th></th></tr>
        </thead>
        <tbody id="group-rows">
        @for (int i = 0; i < Model.Groups.Count; i++)
        {
            <partial name="_GroupRow" model='Model.CreateRow("r" + i, Model.Groups[i], i)' />
        }
        </tbody>
    </table>
    <template id="group-row-template">
        <partial name="_GroupRow" model='Model.CreateRow("__key__", new GroupInput(), -1)' />
    </template>
    <p><button type="button" data-action="add-group">+ Добавить группу</button></p>
    <p class="muted">Пустые строки игнорируются.</p>
    <button type="submit" class="primary">Создать черновик</button>
</form>
