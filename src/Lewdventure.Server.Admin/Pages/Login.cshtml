@page
@model LoginModel
@{
    ViewData["Title"] = "Вход";
}
<div class="login">
    <h1>Lewdventure Admin</h1>
    @if (string.IsNullOrEmpty(Model.Error) == false)
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <form method="post" class="card form">
        <input type="hidden" asp-for="ReturnUrl">
        <label>Логин <input asp-for="Login" autocomplete="username" autofocus required></label>
        <label for="login-password">Пароль</label>
        <div class="password-field">
            <input asp-for="Password" id="login-password" type="password" autocomplete="current-password" required>
            <button type="button" data-action="toggle-password" data-target="login-password" aria-pressed="false">Показать</button>
        </div>
        <button type="submit" class="primary">Войти</button>
    </form>
</div>
