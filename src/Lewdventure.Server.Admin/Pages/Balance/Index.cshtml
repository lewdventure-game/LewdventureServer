@page
@model Server.Admin.Pages.Balance.IndexModel
@using Server.Admin.Pages.Balance
@{
    ViewData["Title"] = "Баланс";
}
@section Head {
    @if (Model.JobPending)
    {
        <meta http-equiv="refresh" content="3">
    }
}
<form method="post" class="balance" id="balance-form">
    <input type="hidden" name="Tab" value="@Model.Tab" data-tab-input>
    <div class="balance-head">
        <div>
            <h1>Баланс · @Model.CurrentEnvironment</h1>
            <p class="muted">Соберите героя слева, выберите задачу справа. Всё считается тем же ядром, что и игра; у игроков ничего не меняется.</p>
        </div>
        <details class="scenario-menu">
            <summary>Сценарии@(Model.ScenarioName.Length == 0 ? string.Empty : " · " + Model.ScenarioName)</summary>
            <div class="scenario-panel">
                <label>Открыть сохранённый
                    <span class="inline">
                        <select name="ScenarioId">
                            <option value="">— выберите —</option>
                            @foreach (var scenario in Model.Scenarios)
                            {
                                <option value="@scenario.Id" selected="@(scenario.Id == Model.ScenarioId)">@scenario.Name · @scenario.UpdatedBy · @scenario.UpdatedAt.ToString("dd.MM HH:mm")</option>
                            }
                        </select>
                        <button type="submit" asp-page-handler="LoadScenario">Открыть</button>
                        @if (Model.IsAdmin)
                        {
                            <button type="submit" asp-page-handler="DeleteScenario" class="danger" data-confirm="Удалить выбранный сценарий?">Удалить</button>
                        }
                    </span>
                </label>
                <label>Сохранить всю форму как
                    <span class="inline">
                        <input name="ScenarioName" value="@Model.ScenarioName" placeholder="например «босс 1-5 после нерфа»">
                        <button type="submit" asp-page-handler="SaveScenario">Сохранить</button>
                    </span>
                </label>
                <p class="hint">Сценарий хранит героя, конфиги, правки и настройки всех вкладок. То же название — перезапись.</p>
            </div>
        </details>
    </div>

    <partial name="_Messages" model="Model" />

    @foreach (var sheet in Model.Catalog.Sheets)
    {
        <datalist id="balance-columns-@sheet.Name">
            @foreach (var column in sheet.Columns)
            {
                <option value="@column"></option>
            }
        </datalist>
    }

    <div class="balance-layout">
        <partial name="_Setup" model="Model" />

        <section class="balance-main">
            <nav class="tabs" role="tablist">
                <button type="button" role="tab" class="tab @(Model.IsTab(IndexModel.BattleTab) ? "active" : string.Empty)" data-action="tab" data-tab="@IndexModel.BattleTab">Бой</button>
                <button type="button" role="tab" class="tab @(Model.IsTab(IndexModel.LevelTab) ? "active" : string.Empty)" data-action="tab" data-tab="@IndexModel.LevelTab">Уровень</button>
                <button type="button" role="tab" class="tab @(Model.IsTab(IndexModel.CompareTab) ? "active" : string.Empty)" data-action="tab" data-tab="@IndexModel.CompareTab">Сравнить A/B</button>
                <button type="button" role="tab" class="tab @(Model.IsTab(IndexModel.SweepTab) ? "active" : string.Empty)" data-action="tab" data-tab="@IndexModel.SweepTab">Перебор</button>
                <button type="button" role="tab" class="tab @(Model.IsTab(IndexModel.HistoryTab) ? "active" : string.Empty)" data-action="tab" data-tab="@IndexModel.HistoryTab">История <span class="count">@Model.History.Count</span></button>
            </nav>

            <div class="tab-panel card" data-tab-panel="@IndexModel.BattleTab" hidden="@(Model.IsTab(IndexModel.BattleTab) == false)">
                <h2>Пройдёт ли герой этот бой?</h2>
                <label>Бой
                    <select name="Fight">
                        @foreach (var level in Model.Catalog.StoryLevels)
                        {
                            <optgroup label="Уровень @level.Id">
                                @for (int stageIndex = 0; stageIndex < level.Stages.Count; stageIndex++)
                                {
                                    var stage = level.Stages[stageIndex];
                                    foreach (var storyEvent in stage.Events)
                                    {
                                        if (storyEvent.EnemyIds.Count == 0)
                                            continue;
                                        var value = Model.FightValue(level.Id, stage.Id, storyEvent.Id);
                                        <option value="@value" selected="@(value == Model.Fight)">Уровень @level.Id, этап @(stageIndex + 1)@(stage.IsBoss ? " (босс)" : string.Empty) — враги @string.Join(", ", storyEvent.EnemyIds)</option>
                                    }
                                }
                            </optgroup>
                        }
                    </select>
                </label>
                <div class="field-title">Сколько боёв посчитать</div>
                <div class="chips">
                    @foreach (var preset in Model.BattlePresets)
                    {
                        <button type="button" class="chip @(Model.Battles == preset ? "active" : string.Empty)" data-action="set-value" data-target="Battles" data-value="@preset">@(preset == 1 ? "1 — пошагово" : preset.ToString())</button>
                    }
                    <input type="number" name="Battles" value="@Model.Battles" min="1" class="chip-input" aria-label="сколько боёв">
                </div>
                <p class="hint">Один бой — подробный лог по ходам. Сотни боёв — процент побед и разброс: с одним и тем же сетапом бои отличаются из-за шанса крита, уклонения и комбо.</p>
                <details class="more">
                    <summary>Дополнительно</summary>
                    <label>Свои враги вместо врагов события
                        <input name="EnemiesText" value="@Model.EnemiesText" placeholder="id врагов через запятую, например 10101, 10102">
                    </label>
                    <label>Сид — с какого начинать
                        <input type="number" name="Seed" value="@Model.Seed" min="0">
                    </label>
                    <p class="hint">Одинаковые сетап, конфиги и сид дают один и тот же бой. Серия берёт сиды подряд, начиная с этого.</p>
                </details>
                <div class="actions">
                    <button type="submit" asp-page-handler="Fight" class="primary">Посчитать бой</button>
                </div>
            </div>

            <div class="tab-panel card" data-tab-panel="@IndexModel.LevelTab" hidden="@(Model.IsTab(IndexModel.LevelTab) == false)">
                <h2>Сколько этапов уровня пройдёт герой?</h2>
                <label>Уровень
                    <select name="LevelId">
                        @foreach (var level in Model.Catalog.StoryLevels)
                        {
                            <option value="@level.Id" selected="@(level.Id == Model.LevelId)">Уровень @level.Id — этапов @level.Stages.Count</option>
                        }
                    </select>
                </label>
                <div class="field-title">Сколько раз пройти уровень</div>
                <div class="chips">
                    @foreach (var preset in Model.LevelRunPresets)
                    {
                        <button type="button" class="chip @(Model.LevelRuns == preset ? "active" : string.Empty)" data-action="set-value" data-target="LevelRuns" data-value="@preset">@preset</button>
                    }
                    <input type="number" name="LevelRuns" value="@Model.LevelRuns" min="1" class="chip-input" aria-label="сколько прогонов">
                </div>
                <p class="hint">Каждый прогон — забег с нуля, как у игрока: события, награды, опыт, выбор перков, ХП между боями. Берётся герой из панели слева без состояния забега.</p>
                <details class="more">
                    <summary>Как играет бот</summary>
                    <label>Какой перк брать
                        <select name="PerkPolicy">
                            <option value="first" selected="@(Model.PerkPolicy == "first")">первый из предложенных</option>
                            <option value="random" selected="@(Model.PerkPolicy == "random")">случайный</option>
                            <option value="priority" selected="@(Model.PerkPolicy == "priority")">по списку приоритетов</option>
                        </select>
                    </label>
                    <label>Список приоритетов перков
                        <input name="PerkPriorityText" value="@Model.PerkPriorityText" placeholder="id через запятую: 5, 2, 7">
                    </label>
                    <label>На развилке жать
                        <select name="ForkPolicy">
                            <option value="firstButton" selected="@(Model.ForkPolicy == "firstButton")">первую кнопку</option>
                            <option value="secondButton" selected="@(Model.ForkPolicy == "secondButton")">вторую кнопку</option>
                            <option value="random" selected="@(Model.ForkPolicy == "random")">случайно</option>
                        </select>
                    </label>
                </details>
                <div class="actions">
                    <button type="submit" asp-page-handler="Level" class="primary">Прогнать уровень</button>
                </div>
            </div>

            <div class="tab-panel card" data-tab-panel="@IndexModel.CompareTab" hidden="@(Model.IsTab(IndexModel.CompareTab) == false)">
                <h2>Что изменится, если поменять конфиги?</h2>
                <div class="field-title">Что сравниваем</div>
                <div class="segmented">
                    <label><input type="radio" name="CompareWhat" value="@IndexModel.SeriesKind" checked="@(Model.CompareWhat == IndexModel.SeriesKind)"> бой из вкладки «Бой»</label>
                    <label><input type="radio" name="CompareWhat" value="@IndexModel.LevelKind" checked="@(Model.CompareWhat == IndexModel.LevelKind)"> уровень из вкладки «Уровень»</label>
                </div>
                <div class="compare-columns">
                    <div class="compare-side">
                        <div class="field-title">Вариант A</div>
                        <p>@Model.ConfigSummary()</p>
                        <p class="hint">Это конфиги из панели слева.</p>
                    </div>
                    <div class="compare-side">
                        <div class="field-title">Вариант B</div>
                        <label>Версия
                            <select name="VersionB">
                                <option value="" selected="@(Model.VersionB.Length == 0)">мастер</option>
                                @foreach (var version in Model.Versions)
                                {
                                    <option value="@version.Version" selected="@(version.Version == Model.VersionB)">@version.ShortVersion · @version.CreatedAt.ToString("dd.MM HH:mm")@(version.IsActive ? " · мастер" : string.Empty)</option>
                                }
                            </select>
                        </label>
                        <div class="field-title">Правки B</div>
                        <partial name="_EditsEditor" model="Model.EditsEditorB()" />
                    </div>
                </div>
                <p class="hint">Герой, бой или уровень и сиды у A и B одинаковые — разница только от конфигов.</p>
                <div class="actions">
                    <button type="submit" asp-page-handler="Compare" class="primary">Сравнить A и B</button>
                </div>
            </div>

            <div class="tab-panel card" data-tab-panel="@IndexModel.SweepTab" hidden="@(Model.IsTab(IndexModel.SweepTab) == false)">
                <h2>При каком значении ячейки бой становится проходимым?</h2>
                <div class="edit-row sweep-cell">
                    <select name="SweepSheet" data-sheet-select aria-label="лист">
                        @foreach (var sheet in Model.Catalog.Sheets)
                        {
                            <option value="@sheet.Name" data-key="@sheet.RowKey" selected="@(string.Equals(sheet.Name, Model.SweepSheet, StringComparison.OrdinalIgnoreCase))">@sheet.Name</option>
                        }
                    </select>
                    <input name="SweepRow" value="@Model.SweepRow" placeholder="id=10101" aria-label="строка" data-row-input>
                    <input name="SweepColumn" value="@Model.SweepColumn" placeholder="колонка" aria-label="колонка" data-column-input>
                </div>
                <div class="row">
                    <label>От <input name="SweepFrom" value="@Model.SweepFrom" inputmode="decimal" placeholder="100"></label>
                    <label>До <input name="SweepTo" value="@Model.SweepTo" inputmode="decimal" placeholder="900"></label>
                    <label>Шаг <input name="SweepStep" value="@Model.SweepStep" inputmode="decimal" placeholder="100"></label>
                </div>
                <div class="field-title">Что считать в каждой точке</div>
                <div class="segmented">
                    <label><input type="radio" name="SweepWhat" value="@IndexModel.SeriesKind" checked="@(Model.SweepWhat == IndexModel.SeriesKind)"> бой из вкладки «Бой»</label>
                    <label><input type="radio" name="SweepWhat" value="@IndexModel.LevelKind" checked="@(Model.SweepWhat == IndexModel.LevelKind)"> уровень из вкладки «Уровень»</label>
                </div>
                <p class="hint">Не больше 25 точек. Число боёв или прогонов в точке — из той вкладки. Правки из панели слева тоже действуют.</p>
                <div class="actions">
                    <button type="submit" asp-page-handler="Sweep" class="primary">Перебрать</button>
                </div>
            </div>

            <div class="tab-panel card" data-tab-panel="@IndexModel.HistoryTab" hidden="@(Model.IsTab(IndexModel.HistoryTab) == false)">
                <h2>История прогонов</h2>
                @if (Model.History.Count == 0)
                {
                    <p class="muted">Пока пусто: серии, прогоны уровня, сравнения и переборы появятся здесь.</p>
                }
                else
                {
                    <table class="table compact" data-csv="история">
                        <thead><tr><th>Когда</th><th>Кто</th><th>Итог</th><th>Правок</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var run in Model.History)
                        {
                            <tr>
                                <td class="nowrap">@run.CreatedAt.ToString("dd.MM HH:mm")</td>
                                <td>@Model.ActorName(run.Actor)</td>
                                <td>@run.Summary</td>
                                <td>@run.Edits</td>
                                <td class="nowrap">
                                    <button type="submit" asp-page-handler="OpenHistory" name="HistoryId" value="@run.Id" class="link-button">в форму</button>
                                    · <a href="@Model.RunLink(run.Id)">ссылка</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <p class="hint">Последние 30 за 90 дней, время UTC. «В форму» подставляет сетап того прогона, «ссылка» — то же самое, чтобы переслать.</p>
                }
            </div>

            <partial name="_Results" model="Model" />
        </section>
    </div>
</form>
