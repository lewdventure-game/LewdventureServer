{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AdminPanel": {
    "DataPath": "data",
    "SessionHours": 12,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  }
}
