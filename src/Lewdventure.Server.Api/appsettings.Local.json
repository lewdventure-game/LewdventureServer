{
  "Logging": {
    "LogLevel": {
      "Server.Battles": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "UseUtcTimestamp": false,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Server": {
    "BindAddress": "Loopback",
    "EnableSwagger": true
  },
  "ConfigPublisher": {
    "Enabled": true,
    "ApiKey": "local-config-key"
  },
  "RateLimit": {
    "Enabled": false
  }
}
