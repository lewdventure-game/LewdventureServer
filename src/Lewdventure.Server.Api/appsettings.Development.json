{
  "Server": {
    "EnableSwagger": true
  },
  "ConfigPublisher": {
    "Enabled": true
  },
  "ReverseProxy": {
    "Enabled": true,
    "KnownNetworks": [
      "172.16.0.0/12"
    ]
  },
  "Mongo": {
    "Enabled": true,
    "DatabaseName": "lewdventure_dev"
  },
  "GameConfig": {
    "Source": "Mongo",
    "FailStartupIfUnavailable": true,
    "LocalCachePath": "/app/cache/config-snapshot.json",
    "BootstrapFromGoogleSheetsIfEmpty": true,
    "ReloadMode": "Poll"
  },
  "Admin": {
    "Enabled": true
  },
  "Alerts": {
    "Enabled": true,
    "EnvironmentLabel": "dev",
    "NotifyOnStartup": true
  }
}
