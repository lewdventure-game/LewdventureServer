{
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Warning"
    }
  },
  "Server": {
    "EnableSwagger": false
  },
  "ConfigPublisher": {
    "Enabled": false
  },
  "ReverseProxy": {
    "Enabled": true,
    "KnownNetworks": [
      "172.16.0.0/12"
    ]
  },
  "Mongo": {
    "Enabled": true,
    "DatabaseName": "lewdventure_prod"
  },
  "GameConfig": {
    "Source": "Mongo",
    "FailStartupIfUnavailable": true,
    "LocalCachePath": "/app/cache/config-snapshot.json",
    "BootstrapFromGoogleSheetsIfEmpty": false,
    "ReloadMode": "Manual"
  },
  "Admin": {
    "Enabled": true
  },
  "Alerts": {
    "Enabled": true,
    "EnvironmentLabel": "prod",
    "NotifyOnStartup": true
  }
}
