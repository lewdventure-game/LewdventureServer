{
  "uid": "lewdventure-overview",
  "title": "Lewdventure: обзор",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "lewdventure"
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Окружение",
        "type": "custom",
        "query": "analytics_dev,analytics_stage,analytics_prod",
        "current": {
          "text": "analytics_dev",
          "value": "analytics_dev"
        },
        "options": [],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Активные игроки по дням (DAU)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfDay(event_time) AS time, uniqExact(user_id) AS dau FROM ${env}.events WHERE $__timeFilter(event_time) GROUP BY time ORDER BY time"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Новые аккаунты по странам",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfDay(event_time) AS time, country, count() AS accounts FROM ${env}.events WHERE $__timeFilter(event_time) AND event_type = 'account_created' GROUP BY time, country ORDER BY time"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "События по типам",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(event_time) AS time, event_type, count() AS events FROM ${env}.events WHERE $__timeFilter(event_time) GROUP BY time, event_type ORDER BY time"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Итоги забегов",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfDay(event_time) AS time, JSONExtractString(event_properties, 'status') AS status, count() AS runs FROM ${env}.events WHERE $__timeFilter(event_time) AND event_type = 'run_finished' GROUP BY time, status ORDER BY time"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Группы экспериментов",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT experiment_id, group_id, uniqExact(user_id) AS users, count() AS events, round(count() / uniqExact(user_id), 1) AS events_per_user, countIf(event_type = 'run_started') AS runs_started, countIf(event_type = 'run_finished' AND JSONExtractString(event_properties, 'status') = 'completed') AS runs_completed, round(avgIf(JSONExtractInt(event_properties, 'stage_index'), event_type = 'run_finished'), 2) AS avg_stage_reached FROM ${env}.events WHERE $__timeFilter(event_time) AND experiment_id != '' GROUP BY experiment_id, group_id ORDER BY experiment_id, group_id"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Удержание по группам (D1, D3, D7, % от группы)",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT f.exp AS experiment_id, f.grp AS group_id, uniqExact(f.user_id) AS users, round(100 * uniqExactIf(f.user_id, a.d = f.d0 + 1) / uniqExact(f.user_id), 1) AS d1, round(100 * uniqExactIf(f.user_id, a.d = f.d0 + 3) / uniqExact(f.user_id), 1) AS d3, round(100 * uniqExactIf(f.user_id, a.d = f.d0 + 7) / uniqExact(f.user_id), 1) AS d7 FROM (SELECT user_id, argMin(experiment_id, event_time) AS exp, argMin(group_id, event_time) AS grp, toDate(min(event_time)) AS d0 FROM ${env}.events WHERE experiment_id != '' GROUP BY user_id) AS f INNER JOIN (SELECT DISTINCT user_id, toDate(event_time) AS d FROM ${env}.events) AS a ON a.user_id = f.user_id GROUP BY experiment_id, group_id ORDER BY experiment_id, group_id"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Последние события",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT event_time, event_type, source, user_id, country, experiment_id, group_id, app_version, event_properties FROM ${env}.events WHERE $__timeFilter(event_time) ORDER BY event_time DESC LIMIT 200"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
