{
	email {$ACME_EMAIL}
}

{$PROD_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	@blocked path /health* /admin/* /swagger* /api/config/*
	respond @blocked 404
	reverse_proxy lewdventure-prod-api:5000
}
