{
	email {$ACME_EMAIL}
}

(api_common) {
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	@ops path /health* /admin/* /swagger*
	respond @ops 404
}

{$DEV_DOMAIN} {
	import api_common
	reverse_proxy lewdventure-dev-api:5000
}

{$STAGE_DOMAIN} {
	import api_common
	reverse_proxy lewdventure-stage-api:5000
}
